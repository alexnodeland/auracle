   "t1": 81.753,
   "words": [80.178, 80.338, 80.678, 80.898, 81.158]
  },
  {
   "id": "loudness1",
   "text": "Loudness is measured the broadcast way, with K weighting and gated blocks.",
   "beat": "loudness",
