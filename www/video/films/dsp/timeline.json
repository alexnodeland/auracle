 ],
 "lines": [
  {
   "id": "intro1",
   "text": "This is how Auracle makes sound, from the patch graph to the live voices.",
   "beat": "intro",
   "t0": 1.5,
   "t1": 5.725,
   "words": [1.54, 1.74, 1.88, 2.08, 2.42, 2.72, 3.553, 3.74, 3.86, 4.1, 4.42, 4.7, 4.8, 5.04]
  },
  {
   "id": "graph1",
   "text": "Underneath is quiver, a modular synthesis library in Rust.",
   "beat": "graph",
   "t0": 7.343,
   "t1": 11.17,
   "words": [7.383, 7.903, 8.103, 8.823, 9.023, 9.343, 9.863, 10.323, 10.643]
  },
  {
   "id": "graph2",
   "text": "On each tick, one sample moves through the whole graph.",
   "beat": "graph",
   "t0": 11.57,
   "t1": 14.598,
   "words": [11.61, 11.79, 11.99, 12.55, 12.79, 13.15, 13.45, 13.71, 13.81, 13.99]
  },
  {
   "id": "graph3",
   "text": "Continuous knobs are atomic values the audio thread reads, so turning one needs no recompile.",
   "beat": "graph",
   "t0": 14.998,
   "t1": 21.33,
   "words": [15.036, 15.518, 16.018, 16.298, 16.738, 17.238, 17.458, 17.878, 18.158, 19.018, 19.318, 19.618, 19.898, 20.198, 20.498]
  },
  {
   "id": "modules1",
   "text": "The palette has forty-two modules, from a plucked string to sidechained dynamics.",
   "beat": "modules",
   "t0": 23.057,
   "t1": 27.725,
   "words": [23.097, 23.237, 23.457, 23.737, 24.217, 25.137, 25.337, 25.457, 25.677, 26.017, 26.357, 26.897]
  },
  {
   "id": "modules2",
   "text": "The filter is a state variable design, or a diode ladder that saturates harder one way.",
   "beat": "modules",
   "t0": 28.125,
   "t1": 33.952,
   "words": [28.171, 28.285, 28.585, 28.865, 29.045, 29.345, 29.805, 30.872, 31.065, 31.225, 31.665, 31.985, 32.265, 32.885, 33.165, 33.505]
  },
  {
   "id": "modules3",
   "text": "Audio and modulation are separate Rust types, so a mistyped patch cannot even be built.",
   "beat": "modules",
   "t0": 34.352,
   "t1": 39.957,
   "words": [34.39, 34.672, 34.972, 35.637, 35.832, 36.252, 36.512, 37.312, 37.652, 37.792, 38.352, 38.632, 38.952, 39.312, 39.492]
  },
  {
   "id": "compile1",
   "text": "Every voice ends with a DC blocker where needed, an exponential envelope, and a limiter.",
   "beat": "compile",
   "t0": 41.629,
   "t1": 47.339,
   "words": [41.668, 41.929, 42.269, 42.649, 42.909, 43.069, 43.469, 43.809, 44.129, 45.029, 45.129, 45.804, 46.629, 46.749, 46.869]
  },
  {
   "id": "compile2",
   "text": "Resonance and feedback are capped, so filters cannot oscillate and delays cannot run away.",
   "beat": "compile",
   "t0": 47.739,
   "t1": 53.309,
   "words": [47.777, 48.339, 48.519, 48.759, 49.079, 49.759, 50.059, 50.479, 50.839, 51.479, 51.619, 52.239, 52.519, 52.819]
  },
  {
   "id": "phrase1",
   "text": "For comparison, every patch plays the same five second phrase.",
   "beat": "phrase",
   "t0": 54.486,
   "t1": 58.408,
   "words": [54.524, 54.686, 55.746, 55.966, 56.246, 56.526, 56.766, 57.046, 57.426, 57.726]
  },
  {
   "id": "phrase2",
   "text": "It holds a C, stabs an octave higher, and plays a two note chord.",
   "beat": "phrase",
   "t0": 58.808,
   "t1": 62.771,
   "words": [58.847, 58.948, 59.188, 59.368, 60.016, 60.428, 60.508, 60.888, 61.428, 61.508, 61.728, 61.928, 62.108, 62.288]
  },
  {
   "id": "phrase3",
   "text": "It ends on a low C, with a long release.",
   "beat": "phrase",
   "t0": 63.171,
   "t1": 65.811,
   "words": [63.211, 63.371, 63.611, 63.751, 63.871, 64.011, 64.631, 64.791, 64.911, 65.151]
  },
  {
   "id": "phrase4",
   "text": "The random seed is reset every render, so the samples repeat bit for bit.",
   "beat": "phrase",
   "t0": 66.211,
   "t1": 70.893,
   "words": [66.251, 66.371, 66.731, 67.051, 67.251, 67.631, 68.071, 68.851, 69.071, 69.231, 69.611, 70.031, 70.271, 70.451]
  },
  {
   "id": "vetting1",
   "text": "First, each raw render goes through a gate.",
