   "t0": 72.343,
   "t1": 74.843,
   "words": [72.383, 73.043, 73.203, 73.463, 73.723, 74.003, 74.243, 74.403]
  },
  {
   "id": "vetting2",
   "text": "It fails silence, runaway peaks, and signals dominated by DC.",
   "beat": "vetting",
   "t0": 75.243,
   "t1": 79.738,
   "words": [75.283, 75.443, 75.723, 76.743, 76.923, 77.683, 77.783, 78.143, 78.723, 79.063]
  },
  {
