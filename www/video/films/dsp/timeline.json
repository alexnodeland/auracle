 ],
 "lines": [
  {
   "id": "intro1",
   "text": "How Auracle makes sound, from the patch graph to the live voices.",
   "beat": "intro",
   "t0": 1.5,
   "t1": 5.283,
   "words": [1.538, 1.84, 2.26, 3.24, 3.32, 3.46, 3.7, 4.02, 4.26, 4.36, 4.58]
  },
  {
   "id": "graph1",
   "text": "Underneath is quiver, a modular synthesis library in Rust.",
   "beat": "graph",
   "t0": 6.629,
   "t1": 10.456,
   "words": [6.669, 7.189, 7.389, 8.109, 8.309, 8.629, 9.149, 9.609, 9.929]
  },
  {
   "id": "graph2",
   "text": "On each tick, one sample moves through the whole graph.",
   "beat": "graph",
   "t0": 10.856,
   "t1": 13.564,
   "words": [10.896, 11.116, 11.416, 11.796, 12.076, 12.476, 12.676, 12.816, 12.996]
  },
  {
   "id": "graph3",
   "text": "Continuous knobs are atomic values the audio thread reads, so turning one needs no recompile.",
   "beat": "graph",
   "t0": 13.964,
   "t1": 20.296,
   "words": [14.002, 14.484, 14.984, 15.264, 15.704, 16.204, 16.424, 16.844, 17.124, 17.984, 18.284, 18.584, 18.864, 19.164, 19.464]
  },
  {
   "id": "modules1",
   "text": "The palette has forty-two modules, from a plucked string to sidechained dynamics.",
   "beat": "modules",
   "t0": 21.629,
   "t1": 26.149,
   "words": [21.667, 21.809, 22.029, 22.309, 22.789, 23.709, 23.909, 24.049, 24.249, 24.589, 24.889, 25.349]
  },
  {
   "id": "modules2",
   "text": "The filter is a state variable design, or a diode ladder that saturates harder one way.",
   "beat": "modules",
   "t0": 26.549,
   "t1": 32.376,
   "words": [26.595, 26.709, 27.009, 27.289, 27.469, 27.769, 28.229, 29.296, 29.489, 29.649, 30.089, 30.409, 30.689, 31.309, 31.589, 31.929]
  },
  {
   "id": "modules3",
   "text": "Audio and modulation are separate Rust types, so a mistyped patch cannot even be built.",
   "beat": "modules",
   "t0": 32.776,
   "t1": 38.381,
   "words": [32.814, 33.096, 33.396, 34.061, 34.256, 34.676, 34.936, 35.736, 36.076, 36.216, 36.776, 37.056, 37.376, 37.736, 37.916]
  },
  {
   "id": "compile1",
   "text": "Every voice ends with a DC blocker where needed, an exponential envelope, and a limiter.",
   "beat": "compile",
   "t0": 39.486,
   "t1": 45.196,
   "words": [39.525, 39.786, 40.126, 40.506, 40.766, 40.926, 41.326, 41.666, 41.986, 42.886, 42.986, 43.661, 44.486, 44.606, 44.726]
  },
  {
   "id": "compile2",
   "text": "Resonance and feedback are capped, so filters cannot oscillate and delays cannot run away.",
   "beat": "compile",
   "t0": 45.596,
   "t1": 51.166,
   "words": [45.634, 46.196, 46.376, 46.616, 46.936, 47.616, 47.916, 48.336, 48.696, 49.336, 49.476, 50.096, 50.376, 50.676]
  },
  {
   "id": "phrase1",
   "text": "For comparison, every patch plays the same five second phrase.",
   "beat": "phrase",
   "t0": 52.343,
   "t1": 56.265,
   "words": [52.381, 52.543, 53.603, 53.823, 54.103, 54.383, 54.623, 54.903, 55.283, 55.583]
  },
  {
   "id": "phrase2",
   "text": "It holds a C, stabs an octave higher, and plays a two note chord.",
   "beat": "phrase",
   "t0": 56.665,
   "t1": 60.628,
   "words": [56.704, 56.805, 57.045, 57.225, 57.873, 58.285, 58.365, 58.745, 59.285, 59.365, 59.585, 59.785, 59.965, 60.145]
  },
  {
   "id": "phrase3",
   "text": "It ends on a low C, with a long release.",
   "beat": "phrase",
   "t0": 61.028,
   "t1": 63.485,
   "words": [61.066, 61.228, 61.448, 61.608, 61.728, 61.908, 62.188, 62.428, 62.588, 62.828]
  },
  {
   "id": "phrase4",
   "text": "The random seed is reset every render, so the samples repeat bit for bit.",
   "beat": "phrase",
