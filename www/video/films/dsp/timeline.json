   "t1": 68.568,
   "words": [63.925, 64.045, 64.405, 64.725, 64.925, 65.305, 65.745, 66.525, 66.745, 66.905, 67.285, 67.705, 67.945, 68.125]
  },
  {
   "id": "vetting1",
