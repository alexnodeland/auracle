      "marks": {"attract": "#booth-attract", "deck": ".pf-deck", "keybed": "#piano"},
      "actions": [
        {"at": "booth2:touch", "op": "hold", "keys": ["a"], "ms": 600},
        {"at": "booth2:touch+0.9", "op": "hold", "keys": ["a", "d", "g"], "ms": "end"}
      ]
    },
    {
      "id": "pl-outro",
      "beat": "outro",
      "pre": 0.5,
      "own_setup": true,
      "setup": [
        {"op": "until", "sel": "#warmstart:not(.hidden)", "ms": 180000},
        {"op": "until", "js": "Number(document.querySelector(\".bf-n[data-n='pool']\")?.textContent || 0) >= 40", "ms": 300000},
        {"op": "click", "sel": ".warm-item >> nth=0"},
        {"op": "click", "sel": ".warm-item >> nth=4"},
        {"op": "click", "sel": ".warm-item >> nth=7"},
        {"op": "click", "sel": "#warm-go"},
        {"op": "until", "sel": "#belief .bl-u", "state": "attached", "ms": 180000},
        {"op": "until", "js": "!document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 240000},
        {"op": "midi", "device": "MIDI keyboard"},
        {"op": "preset", "name": "Glass Pad"},
        {"op": "view", "v": "perform"},
        {"op": "measured", "name": "Glass Pad"},
        {"op": "log", "name": "wiring", "js": "[...document.querySelectorAll('.pf-knob')].slice(0, 6).map((k) => k.querySelector('.pf-k-name').textContent + ':' + (k.classList.contains('search') ? 'search' : k.classList.contains('half-lo') ? 'up' : k.classList.contains('half-hi') ? 'down' : 'both')).join(' ')"},
        {"op": "wait", "ms": 9000},
        {"op": "until", "js": "!document.querySelector('#toasts .toast')", "ms": 45000}
      ],
      "marks": {"offer-pad": ".pf-pad.primary", "offer": ".pf-offer", "blend": ".pf-knob[data-i='6']"},
      "actions": [
        {"at": 0.1, "op": "hold", "keys": ["a", "d", "g"], "until": 0.6, "until_snap": "bar"},
        {"at": 0.6, "snap": "bar", "op": "hold", "keys": ["h", "k", ";"], "ms": 2750},
        {"at": 3.457, "snap": "bar", "op": "hold", "keys": ["f", "h", "k"], "ms": 2750},
        {"at": 6.314, "snap": "bar", "op": "hold", "keys": ["g", "j", "l"], "ms": "end"},
        {"at": "outro1:Nothing", "op": "click", "sel": ".pf-pad.primary"},
        {"at": "outro1:phrase", "op": "drag", "sel": ".pf-knob[data-i='6']", "dy": -90, "ms": 2200}
      ]
    }
  ]
}
