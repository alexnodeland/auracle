   "t0": 15.135,
   "t1": 18.198,
   "words": [15.175, 15.335, 15.615, 15.935, 16.355, 16.495, 16.755, 17.015, 17.195, 17.395]
  },
  {
   "id": "named1",
   "text": "The six controls are named for what you hear: Bright, Snap, Motion, Body, Grit, and Space.",
   "beat": "named",
   "t0": 19.586,
   "t1": 26.076,
   "words": [19.626, 19.766, 20.026, 20.646, 20.766, 20.966, 21.226, 21.366, 21.506, 22.346, 22.986, 23.786, 24.486, 24.934, 25.406, 25.446]
  },
  {
   "id": "named2",
   "text": "None of them is fixed to a knob. For each patch, Auracle measures what every knob does to the sound, and wires each control to the knobs that do the work.",
   "beat": "named",
   "t0": 26.576,
   "t1": 36.886,
   "words": [26.615, 26.876, 27.056, 27.236, 27.476, 27.716, 27.976, 28.096, 29.176, 29.276, 29.536, 30.364, 30.696, 31.427, 31.616, 31.956, 32.236, 32.496, 32.636, 32.776, 33.714, 33.876, 34.316, 34.616, 35.136, 35.396, 35.516, 35.896, 36.136, 36.316, 36.456]
  },
  {
   "id": "hood1",
   "text": "Turn one, and the strip underneath shows the real knobs it's moving.",
   "beat": "hood",
   "t0": 38.157,
   "t1": 42.27,
   "words": [38.195, 38.437, 39.077, 39.177, 39.277, 39.497, 40.317, 40.537, 40.797, 41.037, 41.497, 41.737]
  },
  {
   "id": "hood2",
   "text": "If a patch can't honestly do what a control says, the control turns amber. Turn it anyway, and Auracle adds what's missing, or grows a version that can.",
   "beat": "amber",
   "t0": 43.771,
   "t1": 54.606,
   "words": [43.792, 43.991, 44.171, 44.431, 44.971, 45.351, 45.651, 45.811, 45.931, 46.251, 47.171, 47.251, 47.671, 48.131, 49.411, 49.591, 49.711, 50.751, 50.811, 51.131, 51.591, 51.931, 52.737, 52.911, 53.291, 53.511, 53.791, 54.071]
