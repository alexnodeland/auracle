 "lines": [
  {
   "id": "intro1",
   "text": "PERFORM is where you play Auracle.",
   "beat": "intro",
   "t0": 1.5,
   "t1": 3.717,
   "words": [1.539, 2.296, 2.46, 2.62, 2.78, 3.02]
  },
  {
   "id": "intro2",
   "text": "Everything in it is built for your hands, so nothing in it ever stops the music.",
   "beat": "intro",
   "t0": 4.217,
   "t1": 9.27,
   "words": [4.256, 4.697, 4.977, 5.117, 5.297, 5.477, 5.697, 5.857, 6.697, 6.977, 7.397, 7.637, 7.797, 8.077, 8.438, 8.677]
  },
  {
   "id": "keys1",
   "text": "Play it from your computer keyboard, or plug in any MIDI controller.",
   "beat": "keys",
   "t0": 10.3,
   "t1": 14.735,
   "words": [10.34, 10.62, 10.78, 10.92, 11.06, 11.44, 12.4, 12.72, 13.08, 13.4, 13.66, 13.86]
  },
  {
   "id": "keys2",
   "text": "The first eight knobs you turn claim the eight controls.",
