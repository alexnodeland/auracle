 "lines": [
  {
   "id": "intro1",
   "text": "The math inside Auracle, and why each piece has its shape.",
   "beat": "intro",
   "t0": 1.5,
   "t1": 4.875,
   "words": [1.54, 1.66, 1.94, 2.38, 3.22, 3.38, 3.56, 3.78, 4.02, 4.26, 4.42]
  },
  {
   "id": "utility1",
   "text": "Each patch becomes forty-four features, standardized to one scale.",
   "beat": "utility",
   "t0": 6.629,
   "t1": 10.566,
   "words": [6.669, 6.889, 7.169, 7.529, 8.009, 8.941, 9.653, 9.809, 10.009]
  },
  {
   "id": "utility2",
   "text": "Utility is the maximum over a few linear experts, never their average.",
   "beat": "utility",
   "t0": 10.966,
   "t1": 15.784,
   "words": [11.005, 11.682, 11.846, 12.026, 12.644, 12.906, 13.026, 13.206, 13.506, 14.626, 14.906, 15.106]
  },
  {
   "id": "utility3",
   "text": "So you can love dark drones and bright plucks, and each is scored by its own best lens.",
   "beat": "utility",
   "t0": 16.184,
   "t1": 21.364,
   "words": [16.223, 16.364, 16.484, 16.644, 16.904, 17.264, 17.644, 17.944, 18.164, 18.884, 19.144, 19.384, 19.584, 19.864, 20.124, 20.304, 20.544, 20.764]
  },
  {
   "id": "likelihoods1",
   "text": "Three kinds of answer feed that one utility.",
   "beat": "likelihoods",
   "t0": 23.057,
   "t1": 25.937,
   "words": [23.097, 23.377, 23.637, 23.797, 24.425, 24.697, 24.917, 25.197]
  },
  {
   "id": "likelihoods2",
   "text": "A duel is Bradley-Terry, logistic in the utility difference.",
   "beat": "likelihoods",
   "t0": 26.337,
   "t1": 30.26,
   "words": [26.377, 26.497, 26.757, 27.057, 28.517, 28.897, 29.097, 29.197, 29.577]
  },
  {
   "id": "likelihoods3",
   "text": "Cutting a patch is a kill, judged against a bar fitted per session.",
   "beat": "likelihoods",
   "t0": 30.66,
   "t1": 34.61,
   "words": [30.699, 30.94, 31.08, 31.34, 31.58, 31.72, 32.42, 32.76, 33.08, 33.24, 33.48, 33.8, 34.06]
  },
  {
   "id": "likelihoods4",
   "text": "A picky day moves the bar. Not the taste.",
   "beat": "likelihoods",
   "t0": 35.01,
   "t1": 37.615,
   "words": [35.05, 35.17, 35.47, 35.65, 35.91, 36.09, 36.71, 36.87, 37.03]
  },
  {
   "id": "likelihoods5",
   "text": "Stars fall between fitted cutpoints, so a harsh rater moves the cutpoints.",
   "beat": "likelihoods",
   "t0": 38.015,
   "t1": 42.552,
   "words": [38.053, 38.435, 38.735, 39.075, 39.375, 40.415, 40.615, 40.775, 41.035, 41.435, 41.695, 41.915]
  },
  {
   "id": "posterior1",
   "text": "With no hidden lens labels, every parameter is a real number.",
   "beat": "posterior",
   "t0": 43.771,
   "t1": 47.774,
   "words": [43.81, 43.931, 44.211, 44.451, 44.791, 45.791, 46.031, 46.694, 46.851, 47.031, 47.191]
  },
  {
   "id": "posterior2",
   "text": "So plain Metropolis-Hastings fits it, and keeps five hundred draws.",
