   "t0": 48.174,
   "t1": 52.471,
   "words": [48.214, 48.414, 48.814, 49.794, 50.134, 50.658, 50.874, 51.134, 51.434, 51.734]
  },
  {
   "id": "posterior3",
   "text": "Between fits, each answer reweights the draws, exactly and nearly free.",
   "beat": "posterior",
   "t0": 52.871,
   "t1": 57.399,
   "words": [52.909, 53.191, 53.871, 54.011, 54.411, 54.791, 54.991, 55.691, 56.423, 56.591, 56.871]
  },
  {
   "id": "posterior4",
