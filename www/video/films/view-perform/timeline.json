   "words": [283.696, 284.217, 284.397, 284.497, 284.557, 284.657]
  },
  {
   "id": "together2",
   "text": "An arpeggio at eighty-four, Wander turned up, and an offer growing in B.",
   "beat": "together",
   "t0": 285.76,
   "t1": 290.265,
   "words": [285.843, 285.96, 286.42, 286.54, 287.343, 287.68, 288.06, 288.64, 288.78, 288.88, 289.18, 289.62, 289.82]
