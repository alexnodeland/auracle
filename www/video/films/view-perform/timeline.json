   "text": "When it sounds right, take it on the downbeat.",
   "beat": "together",
   "t0": 292.265,
   "t1": 294.595,
   "words": [292.305, 292.425, 292.545, 292.765, 293.465, 293.565, 293.685, 293.785, 293.905]
  },
  {
