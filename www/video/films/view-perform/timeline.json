   "t1": 259.861,
   "words": [254.725, 254.946, 255.086, 255.226, 255.851, 256.026, 256.226, 256.426, 257.426, 257.546, 257.786, 258.006, 258.166, 258.426, 258.686, 258.846, 259.046]
  },
  {
