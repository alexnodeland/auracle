 ],
 "lines": [
  {
   "id": "title1",
   "text": "PERFORM is where you play the sound.",
   "beat": "title",
   "t0": 13.029,
   "t1": 14.999,
   "words": [13.069, 13.666, 13.809, 13.969, 14.129, 14.309, 14.449]
  },
  {
   "id": "title2",
   "text": "Its controls are named for what you hear, and nothing in it ever stops the music.",
   "beat": "title",
   "t0": 15.599,
   "t1": 20.324,
   "words": [15.639, 15.819, 16.502, 16.659, 16.899, 17.139, 17.279, 17.439, 18.199, 18.359, 18.659, 18.839, 18.999, 19.239, 19.559, 19.779]
  },
  {
   "id": "play1",
   "text": "Two rows of your computer keyboard play the notes: A to L are the white keys, and W to P the black.",
   "beat": "play",
   "t0": 26.114,
   "t1": 32.622,
   "words": [26.153, 26.394, 26.674, 26.894, 27.014, 27.334, 27.794, 28.074, 28.214, 29.155, 29.394, 29.554, 29.814, 29.974, 30.074, 30.274, 31.055, 31.254, 31.574, 31.814, 31.994, 32.114]
  },
  {
   "id": "play2",
   "text": "Z and X shift the octave. Hold Shift for an accent.",
   "beat": "play",
   "t0": 33.422,
   "t1": 36.947,
   "words": [33.459, 33.742, 33.882, 34.162, 34.442, 34.642, 35.479, 35.742, 35.982, 36.242, 36.342]
  },
  {
   "id": "play3",
   "text": "On the screen keys, strike lower down for a harder note.",
   "beat": "play",
   "t0": 37.547,
   "t1": 40.759,
   "words": [37.586, 37.687, 37.827, 38.027, 38.827, 39.087, 39.347, 39.667, 39.887, 39.987, 40.207]
  },
  {
   "id": "play4",
   "text": "A MIDI keyboard plays as well, with velocity and pitch bend.",
   "beat": "play",
   "t0": 41.359,
   "t1": 45.044,
   "words": [41.398, 41.519, 41.639, 42.079, 42.419, 42.619, 43.219, 43.419, 44.083, 44.259, 44.479]
  },
  {
   "id": "play5",
   "text": "Velocity can shape the timbre, too.",
   "beat": "play",
   "t0": 45.844,
   "t1": 47.962,
   "words": [45.883, 46.384, 46.684, 46.964, 47.104, 47.499]
  },
  {
   "id": "play6",
   "text": "With the touch row set to Bright, soft notes come out darker, and hard ones brighter.",
   "beat": "play",
   "t0": 48.262,
   "t1": 53.179,
   "words": [48.302, 48.442, 48.622, 48.822, 49.062, 49.302, 49.482, 50.134, 50.462, 50.842, 51.022, 51.182, 51.897, 52.062, 52.342, 52.582]
  },
  {
   "id": "named1",
   "text": "Six controls are named for what you hear: Bright, Snap, Motion, Body, Grit and Space.",
   "beat": "named",
   "t0": 60.4,
   "t1": 65.905,
   "words": [60.44, 60.72, 61.12, 61.36, 61.52, 61.72, 61.84, 61.96, 62.702, 63.22, 63.9, 64.48, 64.9, 65.28, 65.3]
  },
  {
   "id": "named2",
   "text": "Hold a chord and ride Bright up. It swells, and the note never breaks.",
   "beat": "named",
   "t0": 66.405,
   "t1": 70.63,
   "words": [66.428, 66.665, 66.785, 67.005, 67.205, 67.425, 67.685, 68.385, 68.565, 69.239, 69.385, 69.505, 69.725, 69.985]
  },
  {
   "id": "named3",
   "text": "Underneath, the patch's own knobs move with it.",
   "beat": "named",
   "t0": 71.13,
   "t1": 73.765,
   "words": [71.17, 71.97, 72.05, 72.33, 72.65, 73.01, 73.23, 73.43]
  },
  {
   "id": "named4",
   "text": "Long-press a control to hear what it does on this patch.",
   "beat": "named",
   "t0": 74.365,
   "t1": 77.512,
   "words": [74.404, 74.885, 75.045, 75.787, 75.925, 76.105, 76.305, 76.405, 76.585, 76.785, 76.945]
  },
  {
   "id": "named5",
   "text": "Every patch gets its own wiring.",
   "beat": "named",
   "t0": 79.112,
   "t1": 81.047,
   "words": [79.153, 79.392, 79.733, 79.972, 80.172, 80.373]
  },
  {
   "id": "named6",
   "text": "When one loads, PERFORM nudges each knob and listens.",
   "beat": "named",
   "t0": 81.347,
   "t1": 84.535,
   "words": [81.388, 81.507, 81.667, 82.347, 82.707, 83.108, 83.328, 83.688, 83.907]
  },
  {
   "id": "named7",
   "text": "Then it wires every control to the few knobs that move the sound its way.",
   "beat": "named",
   "t0": 84.935,
   "t1": 89.293,
   "words": [84.975, 85.195, 85.335, 85.675, 86.115, 86.495, 86.695, 86.795, 86.975, 87.715, 87.935, 88.135, 88.335, 88.635, 88.815]
  },
  {
   "id": "named8",
   "text": "On Bell Jar, Bright folds the wave instead. The name stays, and the knobs change.",
   "beat": "named",
   "t0": 89.793,
   "t1": 95.02,
   "words": [89.895, 90.032, 90.273, 90.734, 90.953, 91.252, 91.473, 91.672, 92.793, 92.853, 93.073, 93.835, 93.972, 94.073, 94.373]
  },
  {
   "id": "honest1",
   "text": "Some controls only turn one way.",
   "beat": "honest",
   "t0": 100.4,
   "t1": 102.56,
   "words": [100.439, 100.7, 101.18, 101.56, 101.84, 102.08]
  },
  {
   "id": "honest2",
   "text": "This pad already sits at the close end, so Space can only take it toward far, and the line under it says so.",
   "beat": "honest",
   "t0": 102.96,
   "t1": 109.373,
   "words": [103.0, 103.2, 103.5, 103.78, 104.08, 104.26, 104.36, 104.58, 105.3, 105.52, 105.86, 106.1, 106.38, 106.6, 106.76, 106.94, 107.78, 107.96, 108.08, 108.34, 108.6, 108.82, 108.94]
  },
  {
   "id": "honest3",
   "text": "An amber control with a dashed ring is one this patch can't honestly reach.",
   "beat": "honest",
   "t0": 110.573,
   "t1": 115.098,
   "words": [110.611, 110.733, 111.032, 111.453, 111.713, 111.833, 112.133, 112.885, 113.073, 113.273, 113.473, 113.733, 114.085, 114.473]
  },
  {
   "id": "honest4",
   "text": "Turn it anyway, and it asks for a sound that can.",
   "beat": "honest",
   "t0": 115.498,
   "t1": 118.235,
   "words": [115.537, 115.718, 115.838, 116.578, 116.718, 116.797, 117.078, 117.317, 117.418, 117.578, 117.758]
  },
  {
   "id": "honest5",
   "text": "Grit springs back, and a variant grows in B, marked with what you asked for.",
   "beat": "honest",
   "t0": 118.735,
   "t1": 123.325,
   "words": [118.773, 119.015, 119.335, 120.095, 120.175, 120.275, 120.595, 120.915, 121.175, 121.795, 122.095, 122.315, 122.435, 122.575, 122.875]
  },
  {
   "id": "honest6",
   "text": "It isn't aimed at grit yet, so listen before you take it.",
   "beat": "honest",
   "t0": 123.825,
   "t1": 127.15,
   "words": [123.864, 124.045, 124.325, 124.545, 124.705, 124.845, 125.465, 125.725, 125.985, 126.405, 126.585, 126.785]
  },
  {
   "id": "xy1",
   "text": "The XY pad puts two controls under one hand.",
   "beat": "xy",
   "t0": 134.686,
   "t1": 137.721,
   "words": [134.725, 134.846, 135.206, 135.874, 136.106, 136.366, 136.726, 136.986, 137.206]
  },
  {
   "id": "xy2",
   "text": "Choose them here. Pick an amber one, and the pad tells you it can't move this patch.",
   "beat": "xy",
   "t0": 138.121,
   "t1": 142.813,
   "words": [138.159, 138.381, 138.641, 139.361, 139.541, 139.701, 139.981, 140.561, 140.681, 140.801, 141.061, 141.301, 141.521, 141.621, 141.861, 142.001, 142.241]
  },
  {
   "id": "xy3",
   "text": "Hold a chord, and draw.",
   "beat": "xy",
   "t0": 143.313,
   "t1": 144.743,
   "words": [143.353, 143.593, 143.713, 143.933, 144.193]
  },
  {
   "id": "xy4",
   "text": "The dials follow the dot. Double-click the pad to centre it.",
   "beat": "xy",
   "t0": 148.143,
   "t1": 151.741,
   "words": [148.183, 148.323, 148.803, 149.043, 149.263, 150.043, 150.463, 150.643, 150.883, 151.103, 151.503]
  },
  {
   "id": "offer1",
   "text": "Press Offer, and a variant of what you're playing grows in slot B.",
   "beat": "offer",
   "t0": 157.543,
   "t1": 161.238,
   "words": [157.583, 157.783, 158.503, 158.663, 158.743, 159.063, 159.223, 159.343, 159.503, 159.763, 160.123, 160.443, 160.723]
  },
  {
   "id": "offer2",
   "text": "It follows your hands. Every note you play sounds in both.",
   "beat": "offer",
   "t0": 161.638,
   "t1": 164.923,
   "words": [161.676, 161.778, 162.078, 162.278, 163.118, 163.318, 163.518, 163.698, 163.878, 164.198, 164.418]
  },
  {
   "id": "offer3",
   "text": "Hold Peek to hear B on its own.",
   "beat": "offer",
   "t0": 165.323,
   "t1": 167.223,
   "words": [165.361, 165.663, 165.883, 166.083, 166.243, 166.443, 166.643, 166.783]
  },
  {
   "id": "offer4",
   "text": "Or ride Blend across. B plays at matched loudness, so you judge the sound, not the level.",
   "beat": "offer",
   "t0": 168.223,
   "t1": 173.89,
   "words": [168.262, 168.423, 168.863, 169.083, 170.203, 170.243, 170.543, 170.683, 171.023, 171.856, 172.023, 172.223, 172.423, 172.683, 173.243, 173.343, 173.503]
  },
  {
   "id": "offer5",
   "text": "Press Offer again, and that's a pass.",
   "beat": "offer",
   "t0": 174.39,
   "t1": 176.495,
   "words": [174.43, 174.65, 174.89, 175.55, 175.65, 175.91, 175.97]
  },
  {
   "id": "offer6",
   "text": "Take the next one, and it's your sound.",
   "beat": "offer",
   "t0": 177.295,
   "t1": 179.355,
   "words": [177.331, 177.535, 177.695, 177.895, 178.455, 178.515, 178.655, 178.735]
  },
  {
   "id": "offer7",
   "text": "Once you've heard it, either answer teaches the model what you like.",
   "beat": "offer",
   "t0": 179.955,
   "t1": 183.57,
   "words": [179.993, 180.235, 180.535, 180.695, 181.295, 181.475, 181.855, 182.195, 182.455, 182.735, 182.915, 183.075]
  },
  {
   "id": "wander1",
   "text": "Keep makes the sound you hear home.",
   "beat": "wander",
   "t0": 188.971,
   "t1": 190.694,
   "words": [189.011, 189.211, 189.491, 189.651, 189.831, 189.991, 190.171]
  },
  {
   "id": "wander2",
   "text": "Then turn up Wander, and the model plays the controls with you.",
   "beat": "wander",
   "t0": 191.294,
   "t1": 194.821,
   "words": [191.334, 191.554, 191.814, 192.014, 192.714, 192.934, 193.034, 193.314, 193.634, 193.854, 194.194, 194.454]
  },
  {
   "id": "wander3",
   "text": "A little, and ideas appear in B.",
   "beat": "wander",
   "t0": 195.221,
   "t1": 197.326,
   "words": [195.261, 195.361, 195.841, 195.941, 196.301, 196.621, 196.821]
  },
  {
   "id": "wander4",
   "text": "Further, and the knobs drift toward your taste.",
   "beat": "wander",
   "t0": 197.926,
   "t1": 200.434,
   "words": [197.967, 198.626, 198.706, 198.786, 199.146, 199.406, 199.686, 199.866]
  },
  {
   "id": "wander5",
   "text": "All the way up, and it roams.",
   "beat": "wander",
   "t0": 203.034,
   "t1": 204.614,
   "words": [203.072, 203.294, 203.414, 203.574, 203.774, 203.914, 204.014]
  },
  {
   "id": "wander6",
   "text": "Structure never changes on its own. A new module only arrives as an offer.",
   "beat": "wander",
   "t0": 205.114,
   "t1": 209.969,
   "words": [205.154, 205.764, 205.994, 206.454, 206.674, 206.814, 207.576, 207.734, 207.934, 208.314, 208.714, 209.264, 209.394, 209.494]
  },
  {
   "id": "wander7",
   "text": "Touch anything, and it waits for you. Freeze holds it where it is.",
   "beat": "wander",
   "t0": 210.369,
   "t1": 213.914,
   "words": [210.409, 210.609, 211.219, 211.369, 211.469, 211.649, 211.889, 212.394, 212.729, 213.029, 213.209, 213.369, 213.509]
  },
  {
   "id": "wander8",
   "text": "And Back glides you home, to the sound you kept.",
   "beat": "wander",
   "t0": 214.514,
   "t1": 217.216,
   "words": [214.555, 214.754, 215.014, 215.354, 215.494, 216.063, 216.174, 216.294, 216.514, 216.714]
  },
  {
   "id": "dock1",
   "text": "In the dock, Hold latches the notes you play.",
   "beat": "dock",
   "t0": 223.257,
   "t1": 225.822,
   "words": [223.296, 223.417, 223.517, 223.979, 224.277, 224.737, 224.897, 225.117, 225.317]
  },
  {
   "id": "dock2",
   "text": "Unison stacks all four voices on one note.",
   "beat": "dock",
   "t0": 226.422,
   "t1": 229.08,
   "words": [226.46, 226.882, 227.322, 227.682, 227.942, 228.282, 228.502, 228.662]
  },
  {
   "id": "dock3",
   "text": "Glide slides a line from note to note, and chords stay clean.",
   "beat": "dock",
   "t0": 229.88,
   "t1": 233.405,
   "words": [229.919, 230.28, 230.56, 230.72, 230.92, 231.16, 231.34, 231.5, 232.1, 232.28, 232.5, 232.84]
  },
  {
   "id": "dock4",
   "text": "The arpeggiator plays a held chord at the tempo you set.",
   "beat": "dock",
   "t0": 234.205,
   "t1": 237.36,
   "words": [234.245, 234.365, 235.025, 235.405, 235.585, 235.785, 236.065, 236.285, 236.405, 236.665, 236.885]
  },
  {
   "id": "dock5",
   "text": "Sync puts the patch's own step pattern on that tempo too, so Loom's filter falls into time.",
   "beat": "dock",
   "t0": 237.96,
   "t1": 243.692,
   "words": [237.998, 238.26, 238.52, 238.72, 239.12, 239.32, 239.6, 239.94, 240.14, 240.34, 240.64, 241.46, 241.74, 242.22, 242.54, 242.86, 243.14]
  },
  {
   "id": "dock6",
   "text": "When you like what you hear, REC keeps it as a WAV file.",
   "beat": "dock",
   "t0": 244.692,
   "t1": 247.855,
   "words": [244.731, 244.852, 244.992, 245.192, 245.332, 245.472, 246.069, 246.272, 246.552, 246.772, 246.912, 247.052, 247.252]
  },
  {
