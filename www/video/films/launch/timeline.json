 "lines": [
  {
   "id": "open1",
   "text": "Every synthesizer has a sound in it that's yours.",
   "beat": "open",
   "t0": 2.4,
   "t1": 5.697
  },
  {
   "id": "open2",
   "text": "Finding it means turning hundreds of knobs, one at a time.",
   "beat": "open",
   "t0": 6.397,
   "t1": 10.105
  },
  {
   "id": "title1",
   "text": "Auracle is a synthesizer that searches for your sound.",
   "beat": "title",
   "t0": 13.2,
   "t1": 16.927
  },
  {
   "id": "duel1",
   "text": "It plays you two patches. You pick the one you like better.",
   "beat": "duel",
   "t0": 18.9,
   "t1": 22.51
  },
  {
   "id": "duel2",
   "text": "Every pick teaches it your taste,",
   "beat": "duel",
   "t0": 23.01,
   "t1": 25.037
  },
  {
   "id": "grow1",
   "text": "and it grows new patches toward it.",
   "beat": "grow",
   "t0": 25.487,
   "t1": 27.585
  },
  {
   "id": "grow2",
   "text": "Not samples. Real modular circuits, built and wired from scratch.",
   "beat": "grow",
   "t0": 28.085,
   "t1": 32.565
  },
  {
   "id": "play1",
   "text": "Then you play it.",
   "beat": "play",
   "t0": 34.2,
   "t1": 35.383
  },
  {
   "id": "play2",
   "text": "Turn Bright, and it finds the knobs that make this patch brighter.",
   "beat": "play",
   "t0": 36.283,
   "t1": 39.898
  },
  {
   "id": "play3",
   "text": "Let it wander, and the knobs turn themselves toward your taste.",
   "beat": "play",
   "t0": 40.698,
   "t1": 44.283
  },
  {
   "id": "offer1",
   "text": "Press Offer, and a new version grows from the sound in your hands.",
   "beat": "offer",
   "t0": 46.0,
   "t1": 49.94
  },
  {
   "id": "offer2",
   "text": "Blend into it. Take it, or pass. Either way, it learns.",
   "beat": "offer",
   "t0": 50.64,
   "t1": 54.41
  },
  {
   "id": "depth1",
   "text": "Open the circuit any time. Every knob is real, and you can watch the performance turn them.",
   "beat": "depth",
   "t0": 58.1,
   "t1": 64.285
  },
  {
   "id": "depth2",
   "text": "Underneath, a model of your taste bets on every choice before you make it, and keeps score in public.",
   "beat": "depth",
   "t0": 64.985,
   "t1": 71.29
  },
  {
   "id": "close1",
   "text": "Every note in this film is Auracle.",
