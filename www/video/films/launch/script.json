{
  "film": "launch",
  "title": "Auracle",
  "description": "The launch film: what Auracle is, what it feels like to play, and what is underneath.",
  "fps": 30,
  "voice": {
    "voice": "af_heart",
    "speed": 0.82
  },
  "music": {
    "bed": "n3"
