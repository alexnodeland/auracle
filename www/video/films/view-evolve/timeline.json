   "t1": 186.475,
   "words": [180.606, 180.715, 180.975, 181.315, 181.595, 181.815, 182.035, 182.315, 183.455, 183.615, 183.995, 184.755, 184.895, 185.055, 185.455, 185.775, 186.015]
