 "lines": [
  {
   "id": "title1",
   "text": "PATCH is the inside of the sound.",
   "beat": "title",
   "t0": 12.629,
   "t1": 14.509,
   "words": [12.668, 12.909, 13.129, 13.269, 13.609, 13.849, 13.949]
  },
  {
   "id": "title2",
   "text": "One patch, in full, and playable while you take it apart.",
   "beat": "title",
   "t0": 15.009,
   "t1": 18.399,
   "words": [15.049, 15.269, 15.709, 16.009, 16.634, 16.809, 17.129, 17.449, 17.589, 17.729, 17.849]
  },
  {
   "id": "read1",
   "text": "This is a whole patch: real modules, joined by cables.",
   "beat": "read",
   "t0": 23.857,
   "t1": 27.21,
   "words": [23.895, 24.057, 24.197, 24.317, 24.497, 25.282, 25.517, 26.017, 26.337, 26.577]
  },
  {
   "id": "read2",
   "text": "Sound flows left to right along the green ones.",
   "beat": "read",
   "t0": 27.71,
   "t1": 30.38,
   "words": [27.75, 28.05, 28.37, 28.69, 28.99, 29.17, 29.43, 29.61, 29.83]
  },
  {
   "id": "read3",
   "text": "A stack of saws makes the tone, a filter softens it, and a chorus widens it.",
   "beat": "read",
   "t0": 30.78,
   "t1": 35.667,
   "words": [30.82, 30.96, 31.16, 31.32, 31.74, 31.86, 32.12, 32.96, 33.04, 33.4, 33.98, 34.38, 34.5, 34.66, 34.88, 35.32]
  },
  {
   "id": "read4",
   "text": "The last plate is always the envelope and the output.",
   "beat": "read",
   "t0": 36.067,
   "t1": 39.24,
   "words": [36.098, 36.247, 36.507, 36.767, 36.987, 37.327, 37.527, 38.266, 38.467, 38.567]
  },
  {
   "id": "read5",
   "text": "Amber cables carry movement. This one is a slow LFO, sweeping the filter.",
   "beat": "read",
   "t0": 39.84,
   "t1": 44.967,
   "words": [39.88, 40.18, 40.6, 40.9, 41.902, 42.14, 42.34, 42.52, 42.7, 42.98, 43.877, 44.18, 44.44]
  },
  {
   "id": "read6",
   "text": "Every knob sits where it really is, in hertz, milliseconds and decibels.",
   "beat": "read",
   "t0": 45.567,
   "t1": 50.335,
   "words": [45.606, 45.887, 46.127, 46.427, 46.687, 46.807, 46.987, 47.807, 48.027, 48.867, 49.502, 49.687]
  },
  {
   "id": "hear1",
   "text": "The play button plays the standard sample: five seconds, the same for every patch.",
   "beat": "hear",
   "t0": 57.743,
   "t1": 62.995,
   "words": [57.782, 57.923, 58.223, 58.523, 58.823, 59.043, 59.343, 60.403, 60.703, 61.463, 61.583, 61.823, 62.063, 62.383]
  },
  {
   "id": "hear2",
   "text": "That makes patches fair to compare. To judge a sound, play it.",
   "beat": "hear",
   "t0": 68.495,
   "t1": 72.18,
   "words": [68.534, 68.735, 69.015, 69.375, 69.655, 69.835, 70.795, 70.875, 71.075, 71.275, 71.715, 71.855]
  },
  {
   "id": "hear3",
   "text": "Above the rack, the model guesses how likely you are to prefer this patch, and says why.",
   "beat": "hear",
   "t0": 76.18,
   "t1": 81.298,
   "words": [76.219, 76.44, 76.62, 77.26, 77.42, 77.7, 78.04, 78.36, 78.64, 78.92, 79.04, 79.18, 79.48, 79.74, 80.5, 80.62, 80.82]
  },
  {
   "id": "hear4",
   "text": "Point at a module, and the strip below says what it does, and what the model can't hear.",
   "beat": "hear",
   "t0": 81.898,
   "t1": 86.755,
   "words": [81.937, 82.138, 82.298, 82.398, 83.118, 83.278, 83.378, 83.618, 83.938, 84.218, 84.438, 84.558, 85.298, 85.458, 85.598, 85.718, 86.018, 86.418]
  },
  {
   "id": "hear5",
   "text": "The width of a chorus, for one, is invisible to it.",
   "beat": "hear",
   "t0": 87.155,
   "t1": 90.063,
   "words": [87.195, 87.315, 87.535, 87.675, 87.775, 88.195, 88.275, 88.775, 88.975, 89.575, 89.735]
  },
  {
   "id": "change1",
   "text": "Turn any knob while you play, and the sound follows your hand.",
   "beat": "change",
   "t0": 95.086,
   "t1": 98.568,
   "words": [95.126, 95.346, 95.606, 95.886, 96.126, 96.286, 96.946, 97.106, 97.226, 97.466, 97.886, 98.086]
  },
  {
   "id": "change2",
   "text": "Bypass a module, and it steps out of the sound.",
   "beat": "change",
   "t0": 101.068,
   "t1": 103.898,
   "words": [101.108, 101.568, 101.728, 102.488, 102.608, 102.708, 102.928, 103.128, 103.248, 103.328]
  },
  {
   "id": "change3",
   "text": "Pull a cable, and the socket goes quiet. What it carried waits below, in HELD.",
   "beat": "change",
   "t0": 106.398,
   "t1": 111.186,
   "words": [106.438, 106.618, 106.738, 107.231, 107.378, 107.498, 107.778, 108.078, 109.098, 109.218, 109.338, 109.598, 109.918, 110.358, 110.678]
  },
  {
   "id": "change4",
   "text": "Command-Z puts it back.",
   "beat": "change",
   "t0": 112.686,
   "t1": 114.188,
   "words": [112.724, 113.286, 113.486, 113.666]
  },
  {
   "id": "add1",
   "text": "The node bank holds forty-two modules, ordered the way sound flows through them.",
   "beat": "add",
   "t0": 120.6,
   "t1": 125.177,
   "words": [120.64, 120.74, 121.02, 121.26, 121.6, 122.08, 123.08, 123.36, 123.58, 123.76, 124.16, 124.48, 124.82]
  },
  {
   "id": "add2",
