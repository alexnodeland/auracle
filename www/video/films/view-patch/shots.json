        {"at": "together3:Add-0.3", "op": "seq", "steps": [{"op": "eval", "js": "document.activeElement && document.activeElement.blur()"}, {"op": "key", "key": "/", "ms": 60}, {"op": "wait", "ms": 150}, {"op": "type", "text": "grit", "ms": 85}, {"op": "wait", "ms": 350}, {"op": "mark", "name": "dist", "sel": ".nb-item[data-kind='distortion']"}, {"op": "click", "sel": ".nb-item[data-kind='distortion']"}, {"op": "wait", "ms": 350}, {"op": "move", "sel": "#rack-svg .jack[data-childkey='node'] circle:last-of-type", "ms": 400}, {"op": "wait", "ms": 300}, {"op": "log", "name": "grit", "js": "document.getElementById('nb-status').textContent"}, {"op": "click", "sel": "#rack-svg .jack[data-childkey='node'] circle:last-of-type"}, {"op": "until", "sel": "#rack-svg g.mod-group[data-kind='distortion']", "ms": 30000, "stamp": "grit"}, {"op": "wait", "ms": 300}, {"op": "mark", "name": "distplate", "sel": "#rack-svg g.mod-group[data-kind='distortion']"}, {"op": "mark", "name": "filter2", "sel": "#rack-svg g.mod-group[data-kind='filter']"}, {"op": "log", "name": "rack", "js": "[...document.querySelectorAll('#rack-svg g.mod-group')].map(g => g.dataset.key + ':' + g.dataset.kind).join(' ')"}]},
        {"at": "together4:Lock-0.5", "op": "seq", "steps": [{"op": "until", "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 60000}, {"op": "move", "sel": "#rack-svg g.mod-group[data-kind='filter'] .mod-lock", "ms": 400}, {"op": "click", "sel": "#rack-svg g.mod-group[data-kind='filter'] .mod-lock"}, {"op": "mark", "name": "square", "sel": "#rack-svg g.mod-group[data-kind='filter'] .mod-lock"}]},
        {"at": "together4:commit-0.2", "op": "click", "sel": "#improve-check"},
        {"at": "together4:yours", "op": "click", "sel": "#rack-commit"},
        {"at": "together4:yours+1.2", "op": "seq", "steps": [{"op": "mark", "name": "toast", "sel": "#toasts .toast"}, {"op": "log", "name": "claim", "js": "document.getElementById('toasts').innerText"}]},
        {"at": "together4:yours+2.2", "snap": "bar", "op": "click", "sel": "#hold-btn"}
      ]
    },
    {
      "id": "vp-probe2",
      "beat": "read",
      "pre": 0.5,
      "dur": 40,
      "setup": [
        {"op": "preset", "name": "Glass Pad"},
        {"op": "view", "v": "play"},
        {"op": "until", "sel": "#belief .bl-u", "ms": 90000},
        {"op": "until", "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 180000},
        {"op": "wait", "ms": 800},
        {"op": "eval", "js": "const b = document.getElementById('bt-close'); if (b && b.offsetParent) b.click();"},
        {"op": "key", "key": "a", "ms": 60},
        {"op": "wait", "ms": 1200},
        {"op": "eval", "js": "document.activeElement && document.activeElement.blur()"},
        {"op": "until", "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 180000},
        {"op": "until", "js": "!document.querySelector('#toasts .toast')", "ms": 45000},
        {"op": "log", "name": "rack", "js": "[...document.querySelectorAll('#rack-svg g.mod-group')].map(g => g.dataset.key + ':' + g.dataset.kind).join(' ') + ' || ' + document.getElementById('belief').textContent"}
      ],
      "marks": {"rack": "#rack-scroll"},
      "actions": [
        {"at": 0.5, "op": "log", "name": "before", "js": "'cut ' + document.querySelector(\"#rack-svg [data-addr='node/0#cut']\").getAttribute('aria-valuetext') + ' | res ' + document.querySelector(\"#rack-svg [data-addr='node/0#res']\").getAttribute('aria-valuetext') + ' | ' + document.getElementById('belief').textContent.slice(-40)"},
        {"at": 1.0, "op": "seq", "steps": [{"op": "drag", "sel": "#rack-svg [data-addr='node/0#cut']", "dy": -40, "ms": 500}, {"op": "wait", "ms": 150}, {"op": "drag", "sel": "#rack-svg [data-addr='node/0#res']", "dy": -40, "ms": 500}, {"op": "log", "name": "right after", "js": "'cut ' + document.querySelector(\"#rack-svg [data-addr='node/0#cut']\").getAttribute('aria-valuetext') + ' | res ' + document.querySelector(\"#rack-svg [data-addr='node/0#res']\").getAttribute('aria-valuetext') + ' | ' + document.getElementById('belief').textContent.slice(-40)"}, {"op": "until", "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 60000, "stamp": "settled"}, {"op": "wait", "ms": 1500}, {"op": "log", "name": "settled", "js": "'cut ' + document.querySelector(\"#rack-svg [data-addr='node/0#cut']\").getAttribute('aria-valuetext') + ' | res ' + document.querySelector(\"#rack-svg [data-addr='node/0#res']\").getAttribute('aria-valuetext') + ' | ' + document.getElementById('belief').textContent.slice(-40)"}, {"op": "snap", "name": "settled"}, {"op": "wait", "ms": 6000}, {"op": "log", "name": "later", "js": "'cut ' + document.querySelector(\"#rack-svg [data-addr='node/0#cut']\").getAttribute('aria-valuetext') + ' | res ' + document.querySelector(\"#rack-svg [data-addr='node/0#res']\").getAttribute('aria-valuetext') + ' | ' + document.getElementById('belief').textContent.slice(-40)"}]}
      ]
    }
  ]
}
