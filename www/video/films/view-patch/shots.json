{
 "viewport": [
  1920,
  1080
 ],
 "dpr": 1,
 "query": "?film",
 "init": "(() => { let s = 20260927 >>> 0; Math.random = () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();",
 "setup": [
  {
   "op": "until",
   "sel": "#warmstart:not(.hidden)",
   "ms": 180000
  },
  {
   "op": "until",
   "js": "Number(document.querySelector(\".bf-n[data-n='pool']\")?.textContent || 0) >= 40",
   "ms": 300000
  },
  {
   "op": "log",
   "name": "deal",
   "js": "[...document.querySelectorAll('.warm-item .wi-name')].map(x=>x.textContent).join(' | ')"
  },
  {
   "op": "click",
   "sel": ".warm-item >> nth=0"
  },
  {
   "op": "click",
   "sel": ".warm-item >> nth=4"
  },
  {
   "op": "click",
   "sel": ".warm-item >> nth=7"
  },
  {
   "op": "click",
   "sel": "#warm-go"
  },
  {
   "op": "until",
   "sel": "#belief .bl-u",
   "state": "attached",
   "ms": 180000
  },
  {
   "op": "until",
   "js": "!document.getElementById('wm-lamp').classList.contains('thinking')",
   "ms": 240000
  }
 ],
 "shots": [
  {
   "id": "vp-probe",
   "beat": "read",
   "pre": 0.5,
   "dur": 58,
   "setup": [
    {
     "op": "preset",
     "name": "Glass Pad"
    },
    {
     "op": "view",
     "v": "play"
    },
    {
     "op": "until",
     "sel": "#belief .bl-u",
     "ms": 90000
    },
    {
     "op": "until",
     "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')",
     "ms": 180000
    },
    {
     "op": "wait",
     "ms": 1200
    },
    {
     "op": "log",
     "name": "tour",
     "js": "(document.getElementById('bench-tour')||{}).className + ' | ' + (document.getElementById('bench-tour')?.textContent||'').slice(0,160)"
    },
    {
     "op": "eval",
     "js": "const b=document.getElementById('bt-close'); if (b && b.offsetParent) b.click();"
    },
    {
     "op": "until",
     "js": "!document.querySelector('#toasts .toast')",
     "ms": 45000
    }
   ],
   "marks": {
    "rack": "#rack-scroll"
   },
   "actions": [
    {
     "at": 0.3,
     "op": "seq",
     "steps": [
      {
       "op": "log",
       "name": "mods",
       "js": "[...document.querySelectorAll('#rack-svg g.mod-group')].map(g => g.dataset.key + ':' + g.dataset.kind + '@' + Math.round(g.getBoundingClientRect().x) + ',' + Math.round(g.getBoundingClientRect().y) + ' ' + Math.round(g.getBoundingClientRect().width) + 'x' + Math.round(g.getBoundingClientRect().height)).join(' | ')"
      },
      {
       "op": "log",
       "name": "wires",
       "js": "[...document.querySelectorAll('#rack-svg path.wire')].map(p => p.getAttribute('class') + ' ' + p.dataset.from + '>' + p.dataset.to).join(' | ')"
      },
      {
       "op": "log",
       "name": "tabs",
       "js": "[...document.querySelectorAll('#rack-svg .mod-tab-name')].map(t => t.textContent + '@' + t.closest('g[data-key]')?.dataset.key).join(' | ')"
      },
      {
       "op": "log",
       "name": "jacks",
       "js": "[...document.querySelectorAll('#rack-svg .jack')].map(j => (j.dataset.childkey ? 'in:' + j.dataset.childkey : j.dataset.modkey ? 'mod:' + j.dataset.modkey : j.dataset.outkey ? 'out:' + j.dataset.outkey : '?') + '@' + Math.round(j.getBoundingClientRect().x) + ',' + Math.round(j.getBoundingClientRect().y)).join(' | ')"
      },
      {
       "op": "log",
       "name": "knobs",
       "js": "[...document.querySelectorAll('#rack-svg [data-addr]')].map(k => k.dataset.addr + '=' + (k.getAttribute('aria-valuetext')||'')).join(' | ')"
      },
      {
       "op": "log",
       "name": "belief",
       "js": "document.getElementById('belief').textContent + ' || budget: ' + document.getElementById('budget').textContent"
      },
      {
       "op": "log",
       "name": "chips",
       "js": "[...document.querySelectorAll('.nb-chip')].map(c => c.dataset.kind).join(' ') + ' || groups: ' + [...document.querySelectorAll('#nb-groups .nb-sect, #nb-groups h3')].map(h => h.textContent.trim()).join(' / ') + ' || count: ' + document.getElementById('nb-count').textContent"
      },
      {
       "op": "log",
       "name": "chrome",
       "js": "['nextstep','rack-subject','rack-meta','live-label'].map(id => id + '=' + (document.getElementById(id)?.textContent||'')).join(' | ')"
      },
      {
       "op": "snap",
       "name": "rest"
      }
     ]
    },
    {
     "at": 2.0,
     "op": "hold",
     "keys": [
      "a",
      "d",
      "g"
     ],
     "ms": 2500
    },
    {
     "at": 2.6,
     "op": "snap",
     "name": "chord"
    },
    {
     "at": 5.0,
     "op": "seq",
     "steps": [
      {
       "op": "click",
       "sel": "#rack-play"
      },
      {
       "op": "log",
       "name": "play",
       "js": "document.getElementById('rack-play').className"
      },
      {
       "op": "wait",
       "ms": 5600
      },
      {
       "op": "log",
       "name": "play-after",
       "js": "document.getElementById('rack-play').className"
      }
     ]
    },
    {
     "at": 11.5,
     "op": "seq",
     "steps": [
      {
       "op": "move",
       "sel": ".nb-chip[data-kind='chorus']",
       "ms": 400
      },
      {
       "op": "wait",
       "ms": 700
      },
      {
       "op": "log",
       "name": "spec",
       "js": "document.getElementById('spec-dock').innerText"
      },
      {
       "op": "snap",
       "name": "spec"
      },
      {
       "op": "move",
       "sel": "#rack-subject",
       "ms": 300
      }
     ]
    },
    {
     "at": 14.5,
     "op": "seq",
     "steps": [
      {
       "op": "eval",
       "js": "document.activeElement && document.activeElement.blur()"
      },
      {
       "op": "key",
       "key": "/",
       "ms": 80
      },
      {
       "op": "wait",
       "ms": 300
      },
      {
       "op": "type",
       "text": "grit",
       "ms": 90
      },
      {
       "op": "wait",
       "ms": 500
      },
      {
       "op": "log",
       "name": "grit",
       "js": "[...document.querySelectorAll('.nb-item')].filter(i => i.offsetParent).map(i => i.dataset.kind).join(' ') + ' | q=' + document.getElementById('nb-q').value"
      },
      {
       "op": "snap",
       "name": "grit"
      },
      {
       "op": "key",
       "key": "Escape",
       "ms": 80
      },
      {
       "op": "wait",
       "ms": 300
      },
      {
       "op": "log",
       "name": "after-esc",
       "js": "document.getElementById('nb-q').value + ' | visible ' + [...document.querySelectorAll('.nb-item')].filter(i => i.offsetParent).length + ' | active ' + document.activeElement.id"
      },
      {
       "op": "eval",
       "js": "document.activeElement && document.activeElement.blur()"
      }
     ]
    },
    {
     "at": 19.0,
     "op": "seq",
     "steps": [
      {
       "op": "hold",
       "keys": [
        "a",
        "d",
        "g"
       ],
       "ms": 1500
      }
     ]
    },
    {
     "at": 19.3,
     "op": "seq",
     "steps": [
      {
       "op": "drag",
       "sel": "#rack-svg .jack[data-childkey='node/0/0'] circle:last-of-type",
       "dx": -40,
       "dy": 150,
       "ms": 700
      },
      {
       "op": "wait",
       "ms": 300
      },
      {
       "op": "log",
       "name": "unplug-toast",
       "js": "document.getElementById('toasts').innerText"
      },
      {
       "op": "until",
       "sel": "#tray-items .tray-item",
       "ms": 30000,
       "stamp": "held"
      },
      {
       "op": "log",
       "name": "tray",
       "js": "document.getElementById('tray').innerText + ' || mods ' + [...document.querySelectorAll('#rack-svg g.mod-group')].map(g => g.dataset.key + ':' + g.dataset.kind).join(' ')"
      },
      {
       "op": "snap",
       "name": "unplugged"
      },
      {
       "op": "until",
       "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')",
       "ms": 60000,
       "stamp": "settled1"
      },
      {
       "op": "hold",
       "keys": [
        "Control",
        "z"
       ],
       "ms": 150
      },
      {
       "op": "until",
       "js": "!!document.querySelector(\"#rack-svg g.mod-group[data-key='node/0/0'][data-kind='supersaw']\")",
       "ms": 60000,
       "stamp": "undone"
      },
      {
       "op": "log",
       "name": "after-undo",
       "js": "document.getElementById('tray').innerText + ' || ' + document.getElementById('toasts').innerText"
      },
      {
       "op": "snap",
       "name": "undone"
      }
     ]
    },
    {
     "at": 30.0,
     "op": "seq",
     "steps": [
      {
       "op": "until",
       "js": "!/re-measuring/.test(document.getElementById('belief').textContent) && !document.getElementById('wm-lamp').classList.contains('thinking')",
       "ms": 60000
      },
      {
       "op": "click",
       "sel": "#rack-svg g.mod-group[data-key='node'] .mod-menu-btn"
      },
      {
       "op": "until",
       "sel": "#ctx-menu .cm-item",
       "ms": 5000
      },
      {
       "op": "log",
       "name": "menu",
       "js": "document.getElementById('ctx-menu').innerText"
      },
      {
       "op": "snap",
       "name": "menu"
      },
      {
       "op": "click",
       "sel": "#ctx-menu .cm-item:has-text('bypass')"
      },
      {
       "op": "until",
       "js": "document.querySelectorAll('#tray-items .tray-item').length >= 1 && !document.querySelector(\"#rack-svg g.mod-group[data-kind='chorus']\")",
       "ms": 30000,
       "stamp": "bypassed"
      },
      {
       "op": "log",
       "name": "bypass",
       "js": "document.getElementById('tray').innerText + ' || ' + document.getElementById('toasts').innerText"
      },
      {
       "op": "snap",
       "name": "bypassed"
      }
     ]
    },
    {
     "at": 40.0,
     "op": "seq",
     "steps": [
      {
       "op": "click",
       "sel": ".preset-item:has(.bi-name:text-is('Detune Dream'))"
      },
      {
       "op": "until",
       "js": "(document.getElementById('rack-subject').textContent||'').includes('Detune Dream')",
       "ms": 60000,
       "stamp": "detune"
      },
      {
       "op": "wait",
       "ms": 1500
      },
      {
       "op": "log",
       "name": "detune",
       "js": "[...document.querySelectorAll('#rack-svg g.mod-group')].map(g => g.dataset.key + ':' + g.dataset.kind).join(' ') + ' || ' + document.getElementById('belief').textContent"
      },
      {
       "op": "snap",
       "name": "detune"
      }
     ]
    }
   ]
  }
 ]
}