{
  "viewport": [1920, 1080],
  "dpr": 1,
  "query": "?film",
  "init": "(() => { let s = 20260927 >>> 0; Math.random = () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();",
  "setup": [
    {"op": "until", "sel": "#warmstart:not(.hidden)", "ms": 180000},
    {"op": "until", "js": "Number(document.querySelector(\".bf-n[data-n='pool']\")?.textContent || 0) >= 40", "ms": 300000},
    {"op": "click", "sel": ".warm-item >> nth=0"},
    {"op": "click", "sel": ".warm-item >> nth=4"},
    {"op": "click", "sel": ".warm-item >> nth=7"},
    {"op": "click", "sel": "#warm-go"},
    {"op": "until", "sel": "#belief .bl-u", "state": "attached", "ms": 180000},
    {"op": "until", "js": "!document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 240000}
  ],
  "shots": [
    {
      "id": "sd-intro",
      "beat": "intro",
      "pre": 1.5,
      "setup": [
        {"op": "preset", "name": "Glass Pad"},
        {"op": "view", "v": "play"},
        {"op": "until", "sel": "#belief .bl-u", "ms": 90000},
        {"op": "wait", "ms": 1200},
        {"op": "until", "js": "!document.querySelector('#toasts .toast')", "ms": 45000}
      ],
      "marks": {"rack": "#rack-scroll", "subject": "#rack-subject"},
      "actions": [
        {"at": 0.3, "op": "hold", "keys": ["a", "d", "g"], "ms": "end"}
      ]
    },
    {
      "id": "sd-open",
      "beat": "open",
      "pre": 0.5,
      "setup": [
        {"op": "preset", "name": "Glass Pad"},
        {"op": "view", "v": "play"},
        {"op": "until", "sel": "#belief .bl-u", "ms": 90000},
        {"op": "wait", "ms": 1200},
        {"op": "until", "js": "!document.querySelector('#toasts .toast')", "ms": 45000}
      ],
      "marks": {"filter": "#rack-svg g.mod-group[data-key='node/0']", "hz": "#rack-svg [data-addr='node/0#cut']", "ms": "#rack-svg [data-addr='amp#release']", "db": "#rack-svg [data-addr='amp#sustain']", "belief": "#belief"},
      "actions": [
        {"at": 0.2, "op": "hold", "keys": ["a", "d", "g"], "ms": "end"},
        {"at": "open1:edit", "op": "drag", "sel": "#rack-svg [data-addr='node/0#cut']", "dy": -60, "ms": 1500},
        {"at": "open3:updates", "op": "drag", "sel": "#rack-svg [data-addr='node/0#res']", "dy": -40, "ms": 1000},
        {"at": "open3:edit", "op": "mark", "name": "belief", "sel": "#belief"},
        {"at": "open3:edit", "op": "log", "name": "belief", "js": "document.getElementById('belief').textContent"}
      ]
    },
    {
      "id": "sd-lock",
      "beat": "lock",
      "pre": 0.5,
      "setup": [
        {"op": "preset", "name": "Glass Pad"},
        {"op": "view", "v": "play"},
        {"op": "until", "sel": "#belief .bl-u", "ms": 90000},
        {"op": "wait", "ms": 1200},
        {"op": "until", "js": "!document.querySelector('#toasts .toast')", "ms": 45000}
      ],
      "marks": {"knobs": "#lock-knobs", "wiring": "#lock-structure", "chorus": "#rack-svg g.mod-group[data-key='node']"},
      "actions": [
        {"at": 0.2, "op": "hold", "keys": ["h", "k", ";"], "ms": "end"},
        {"at": "lock1:dot-0.6", "op": "move", "sel": "#rack-svg [data-addr='node/0#cut']", "ms": 400},
        {"at": "lock1:dot", "op": "click", "sel": "#rack-svg [data-addr='node/0#cut'] .lock-dot"},
        {"at": "lock1:dot+0.1", "op": "mark", "name": "dot", "sel": "#rack-svg [data-addr='node/0#cut'] .lock-dot"},
        {"at": "lock1:square-0.5", "op": "move", "sel": "#rack-svg g.mod-group[data-key='node'] .mod-lock", "ms": 400},
        {"at": "lock1:square", "op": "click", "sel": "#rack-svg g.mod-group[data-key='node'] .mod-lock"},
        {"at": "lock1:square+0.1", "op": "mark", "name": "square", "sel": "#rack-svg g.mod-group[data-key='node'] .mod-lock"},
        {"at": "lock2:knob", "op": "move", "sel": "#lock-knobs", "ms": 400},
        {"at": "lock2:wiring", "op": "move", "sel": "#lock-structure", "ms": 400}
