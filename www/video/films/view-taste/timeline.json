   "t0": 131.775,
   "t1": 134.675,
   "words": [131.815, 132.435, 132.635, 132.975, 133.255, 133.535, 133.755, 133.975]
  },
  {
   "id": "dir4",
   "text": "Some rows are what you hear, like shimmer and brightness. Others are what the patch is built from, like reverbs.",
   "beat": "directions",
   "t0": 135.175,
   "t1": 141.73,
   "words": [135.213, 135.475, 135.795, 136.015, 136.135, 136.295, 136.975, 137.075, 137.395, 137.695, 138.955, 139.346, 139.495, 139.635, 139.775, 139.995, 140.235, 140.415, 140.895, 140.995]
  },
  {
   "id": "dir5",
   "text": "Read the whisker, not the bar. A whisker across the centre line is still a guess, and here most are.",
   "beat": "directions",
   "t0": 142.23,
   "t1": 148.267,
   "words": [142.27, 142.53, 142.71, 143.33, 143.47, 143.63, 144.51, 144.61, 144.99, 145.25, 145.51, 145.69, 146.11, 146.31, 146.55, 146.67, 147.29, 147.37, 147.55, 147.927]
  },
  {
