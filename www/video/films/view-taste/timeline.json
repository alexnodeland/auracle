   "t0": 156.288,
   "t1": 162.148,
   "words": [156.328, 156.428, 156.548, 157.408, 157.548, 158.147, 158.308, 159.408, 159.468, 159.888, 160.168, 160.448, 160.628, 160.968, 161.268, 161.628]
  },
  {
   "id": "trust4",
   "text": "The number to trust is its score on duels dealt at random. Here, twenty-seven percent sharper than chance.",
   "beat": "trust",
   "t0": 162.548,
   "t1": 169.441,
   "words": [162.588, 162.688, 162.828, 163.048, 163.604, 163.768, 163.928, 164.248, 164.488, 164.868, 165.068, 165.308, 166.408, 167.248, 167.628, 168.108, 168.508, 168.828]
  },
  {
   "id": "trust5",
   "text": "Early on, not beating a coin flip is the honest answer. Keep picking.",
   "beat": "trust",
   "t0": 169.841,
   "t1": 174.088,
   "words": [169.881, 170.101, 170.641, 170.781, 171.001, 171.221, 171.461, 171.681, 171.881, 172.041, 172.301, 173.361, 173.481]
  },
  {
