   "t1": 167.42,
   "words": [161.159, 161.28, 161.4, 161.64, 162.02, 162.32, 162.46, 162.74, 162.96, 163.34, 163.56, 163.78, 164.88, 165.6, 165.78, 166.12, 166.54, 166.8]
  },
  {
   "id": "trust5",
   "text": "Early on, not beating a coin flip is the honest answer. Keep picking.",
   "beat": "trust",
   "t0": 167.82,
   "t1": 172.067,
   "words": [167.86, 168.08, 168.62, 168.76, 168.98, 169.2, 169.44, 169.66, 169.86, 170.02, 170.28, 171.34, 171.46]
  },
  {
   "id": "wrong1",
   "text": "When it's wrong about you, tell it.",
