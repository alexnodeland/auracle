   "text": "So should you believe it?",
   "beat": "trust",
   "t0": 149.586,
   "t1": 150.938,
   "words": [149.625, 149.806, 149.986, 150.146, 150.446]
  },
  {
   "id": "trust2",
   "text": "Before every duel, it forecasts your answer. Then you pick, and it keeps score.",
   "beat": "trust",
   "t0": 151.238,
   "t1": 155.888,
   "words": [151.277, 151.618, 151.978, 152.198, 152.458, 152.945, 153.098, 153.938, 154.138, 154.298, 154.833, 154.978, 155.098, 155.298]
  },
  {
   "id": "trust3",
   "text": "On the diagonal, its confidence is honest. The whiskers show how little each dot stands on.",
