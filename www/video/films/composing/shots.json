        {"op": "click", "sel": "#choose-a"},
        {"op": "wait", "ms": 1500},
        {"op": "click", "sel": "#choose-b"},
        {"op": "wait", "ms": 1500},
        {"op": "click", "sel": "#choose-a"},
        {"op": "wait", "ms": 1500},
