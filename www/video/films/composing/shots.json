        {"op": "click", "sel": "#choose-b"},
        {"op": "wait", "ms": 1500},
        {"op": "click", "sel": "#choose-a"},
        {"op": "wait", "ms": 1500},
        {"op": "click", "sel": "#choose-b"},
        {"op": "wait", "ms": 1500},
        {"op": "click", "sel": "#choose-a"},
        {"op": "wait", "ms": 1500},
        {"op": "click", "sel": "#choose-b"},
        {"op": "wait", "ms": 1500},
        {"op": "until", "js": "!document.getElementById('wm-lamp').classList.contains('thinking')", "ms": 240000},
