        {"at": "intro1:texture-0.25", "op": "click", "sel": ".bank-item.preset-item:has(.bi-name:text-is('Loom')) .bi-name"},
        {"at": "intro1:texture+0.4", "op": "hold", "keys": ["a", "g"], "ms": "end"}
      ]
    },
    {
