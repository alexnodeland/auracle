{
  "viewport": [1920, 1080],
  "dpr": 1,
  "query": "?film",
  "init": "(() => { let s = 20260927 >>> 0; Math.random = () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();",
  "setup": [
    {"op": "click", "sel": "#warm-skip"},
    {"op": "until", "js": "Number(document.querySelector(\".bf-n[data-n='pool']\")?.textContent || 0) >= 40", "ms": 300000}
  ],
  "shots": [
    {
      "id": "co-intro",
      "beat": "intro",
      "pre": 1.5,
      "setup": [
        {"op": "preset", "name": "Loom"},
        {"op": "preset", "name": "Glass Pad"},
        {"op": "preset", "name": "First Bass"},
        {"op": "view", "v": "play"},
        {"op": "wait", "ms": 1500},
        {"op": "until", "js": "!document.querySelector('#toasts .toast')", "ms": 45000}
