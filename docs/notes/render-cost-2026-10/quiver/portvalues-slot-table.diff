     /// Dense slot holding `id`, whether or not it currently holds a value.
     #[inline]
     fn slot_of(&self, id: PortId) -> Option<usize> {
+        let i = id as usize;
+        if i < SLOT_TABLE {
+            return match self.table.get(i) {
+                Some(&s) if s != 0 => Some(s as usize - 1),
+                _ => None,
+            };
+        }
         self.ids.iter().position(|&candidate| candidate == id)
     }
 
+    /// Push a new slot for `id` holding `value`.
     #[inline]
+    fn push_slot(&mut self, id: PortId, value: Option<f64>) {
+        let i = id as usize;
+        if i < SLOT_TABLE {
+            if self.table.len() <= i {
+                self.table.resize(i + 1, 0);
+            }
+            self.table[i] = (self.ids.len() + 1) as u16;
+        }
+        self.ids.push(id);
+        self.values.push(value);
+    }
